#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        new_macromenu: new_macromenu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp RCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp RCLK>;

            label = "NEW_MACROMENU";
        };

        new_macroblue: new_macroblue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp NUMBER_5>;
            label = "NEW_MACROBLUE";
        };

        new_macrored: new_macrored {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp NUMBER_2>;
            label = "NEW_MACRORED";
        };

        new_macroneebiew: new_macroneebiew {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp ENTER>;
            label = "NEW_MACRONEEBIEW";
        };

        new_macroclear: new_macroclear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp NUMBER_0>;
            label = "NEW_MACROCLEAR";
        };

        new_macrodelete: new_macrodelete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(DELETE) &kp Y>;
            label = "NEW_MACRODELETE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC            &kp N1     &kp N2     &kp N3  &kp N4  &kp N5        &kp UP_ARROW     &kp N6      &kp N7         &kp N8      &kp N9     &kp N0        &kp CAPSLOCK
&kp TAB            &kp Q      &kp W      &kp E   &kp R   &kp T         &kp DOWN_ARROW   &kp Y       &kp U          &kp I       &kp O      &kp P         &kp LEFT_BRACKET
&kp RIGHT_SHIFT    &kp A      &kp S      &kp D   &kp F   &kp G         &kp LEFT_ARROW   &kp H       &kp J          &kp K       &kp L      &kp MINUS     &kp SEMICOLON
&kp RIGHT_CONTROL  &kp Z      &kp X      &kp C   &kp V   &kp B         &kp RIGHT_ARROW  &kp N       &kp M          &kp COMMA   &kp DOT    &kp FSLH      &kp LEFT_ALT
&kp C_MUTE         &kp SPACE  &kp SPACE  &mo 2   &mo 1   &kp RETURN    &kp ENTER        &kp RETURN  &kp BACKSPACE  &kp DELETE  &kp SPACE  &kp LEFT_GUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>,
                <&rsr_trans>;

            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp LC(W)          &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LC(LS(T))         &kp UP_ARROW     &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &kp COLON     &kp LS(MINUS)
&new_macroclear    &kp LC(Y)        &kp F2             &kp BACKSPACE       &kp DELETE           &kp LC(LA(V))         &kp DOWN_ARROW   &kp N5            &kp NUMBER_6      &kp NUMBER_7           &kp NUMBER_8       &kp NUMBER_9  &kp LS(APOSTROPHE)
&kp F5             &kp LC(Z)        &kp LC(LS(N))      &kp LC(C)           &kp LC(V)            &kp SPACE             &kp LEFT_ARROW   &kp NUMBER_0      &kp NUMBER_1      &kp NUMBER_2           &kp NUMBER_3       &kp NUMBER_4  &kp APOSTROPHE
&new_macroneebiew  &kp T            &new_macromenu     &kp X               &new_macroblue       &kp LS(DOWN_ARROW)    &kp RIGHT_ARROW  &kp HASH          &kp PERCENT       &kp LS(NUMBER_6)       &kp EXCLAMATION    &kp QUESTION  &kp EQUAL
&to 0              &trans           &trans             &to 3               &trans               &to 4                 &kp RETURN       &trans            &trans            &trans                 &trans             &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;

            display-name = "LAYER1";
        };

        layer_2 {
            bindings = <
&kp UP_ARROW     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp UP_ARROW     &kp LG(D)  &trans  &trans  &kp LG(LS(S))  &kp LG(PRINTSCREEN)  &kp HOME
&kp DOWN_ARROW   &kp Y         &kp U         &kp I         &kp O         &kp P           &kp DOWN_ARROW   &kp F5     &kp F6  &kp F7  &kp F8         &kp F9               &kp F12
&kp LEFT_ARROW   &kp H         &kp J         &kp K         &kp L         &kp MINUS       &kp LEFT_ARROW   &kp F10    &kp F1  &kp F2  &kp F3         &kp F4               &kp F11
&kp RIGHT_ARROW  &kp N         &kp M         &kp COMMA     &kp PERIOD    &kp SLASH       &kp RIGHT_ARROW  &trans     &trans  &trans  &trans         &trans               &kp END
&to 0            &trans        &trans        &trans        &to 3         &to 4           &kp ENTER        &trans     &trans  &trans  &trans         &kp LA(LC(DELETE))
            >;

            display-name = "LAYER2";
            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp ESCAPE        &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp UP_ARROW     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&kp TAB           &kp Q         &kp W           &kp E         &kp R         &kp T           &kp DOWN_ARROW   &kp Y         &kp U         &kp I         &kp O         &kp P         &trans
&kp LEFT_SHIFT    &kp A         &kp S           &kp D         &kp F         &kp G           &kp LEFT_ARROW   &kp H         &kp J         &kp K         &kp L         &kp MINUS     &trans
&kp LEFT_CONTROL  &kp Z         &kp X           &kp C         &kp V         &kp B           &kp RIGHT_ARROW  &kp N         &kp M         &kp COMMA     &kp PERIOD    &trans        &trans
&to 0             &kp UP_ARROW  &kp DOWN_ARROW  &kp SPACE     &kp LEFT_ALT  &kp ENTER       &trans           &kp ENTER     &kp SPACE     &trans        &trans        &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_4 {
            bindings = <
&kp LC(W)        &kp PAGE_UP  &kp PAGE_DOWN   &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LC(LS(T))         &kp UP_ARROW     &kp NUMBER_6        &kp X               &kp C                &trans               &trans  &trans
&new_macroclear  &kp LC(Y)    &kp F2          &kp BACKSPACE       &kp DELETE           &kp LC(LA(V))         &kp DOWN_ARROW   &trans              &kp PAGE_UP         &kp PAGE_DOWN        &trans               &trans  &trans
&kp F5           &kp LC(Z)    &kp LC(LS(N))   &kp C               &kp LC(V)            &kp SPACE             &kp LEFT_ARROW   &kp LC(LEFT_ARROW)  &kp LEFT_ARROW      &kp RIGHT_ARROW      &kp LC(RIGHT_ARROW)  &trans  &trans
&trans           &kp T        &new_macromenu  &kp X               &new_macroblue       &kp LS(DOWN_ARROW)    &kp RIGHT_ARROW  &kp LS(LEFT_ARROW)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LS(RIGHT_ARROW)  &trans  &new_macrodelete
&to 0            &to 5        &trans          &trans              &trans               &kp ENTER             &trans           &kp ENTER           &kp SPACE           &kp F4               &kp LA(F4)           &trans
            >;

            display-name = "LAYER4";
            sensor-bindings =
                <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>,
                <&rsr_trans>;
        };

        layer_5 {
            bindings = <
&sys_reset  &trans  &trans  &trans  &trans  &bootloader    &rgb_ug RGB_TOG    &out OUT_TOG  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans      &trans  &trans  &trans  &trans  &trans         &ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans        &trans
&trans      &trans  &trans  &trans  &trans  &trans         &rgb_ug RGB_BRD    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&soft_off   &trans  &trans  &trans  &trans  &trans         &rgb_ug RGB_BRI    &trans        &trans        &trans        &trans        &trans        &trans
&to 0       &trans  &trans  &trans  &trans  &trans         &trans             &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
